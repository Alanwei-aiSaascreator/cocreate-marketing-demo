# 这个文件在 pnpm install 时会被自动复制为 .env（见 scripts/postinstall.mjs）。
# .env 不会被提交到仓库，可以放心把真实 key 填进去。

# SQLite 本地库；换 Postgres 时同步改 prisma/schema.prisma 的 provider
DATABASE_URL="file:./dev.db"

# ── AI 层 ─────────────────────────────────────────────
# auto = 有 key 就用真模型，调用失败/限流/超时/返回不合法则自动降级到内置规则引擎
# llm  = 严格模式：必须走模型，失败直接抛错，不允许静默降级（用于验证模型链路）
# rule = 强制走规则引擎（演示时可现场切换，对比两种产出）
LLM_MODE="auto"

# 任何 OpenAI 兼容接口都可以：DeepSeek / 通义 / 智谱 / OpenAI / 自建网关
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-chat"

# ── 商家后台口令（可选）─────────────────────────────────
# 留空 = 演示模式，商家接口完全放开，但界面和 README 都会明确标注「未鉴权」。
# 填上之后，/merchant/* 与 /api/merchant/* 都需要先输入口令，未授权直接 401。
# 注意：这只是最简保护，不是生产方案 —— 生产还需要商家账号体系、
#      资源归属校验（核销时确认这张券属于当前商家）与写接口限流。
MERCHANT_PASSWORD=""
