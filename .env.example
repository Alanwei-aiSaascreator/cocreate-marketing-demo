# 复制为 .env 后即可运行（.env 不会被提交到仓库）

# SQLite 本地库；换 Postgres 时同步改 prisma/schema.prisma 的 provider
DATABASE_URL="file:./dev.db"

# ── AI 层 ─────────────────────────────────────────────
# auto = 有 key 就用真模型，调用失败/限流/超时自动降级到内置规则引擎
# llm  = 强制走模型（失败即报错，用于验证模型链路）
# rule = 强制走规则引擎（演示时可现场切换，对比两种产出）
LLM_MODE="auto"

# 任何 OpenAI 兼容接口都可以：DeepSeek / 通义 / 智谱 / OpenAI / 自建网关
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-chat"
