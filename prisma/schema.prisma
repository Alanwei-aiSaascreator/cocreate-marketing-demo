// 共创营销 Demo · 数据模型
// 注意：SQLite 不支持 enum / Json / 数组，所有结构化字段统一用 String 存 JSON，
// 在 lib/json.ts 里做类型化读写。这样换成 Postgres 时字段无需改动。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 运行时设置（键值对）。
///
/// 存在的理由：让克隆仓库的人在**浏览器里**填 AI 密钥，而不是去改 .env 再重启。
/// 优先级是「界面设置 > .env」——
/// CI / 部署环境仍然可以只用环境变量，界面上填过的会覆盖它。
///
/// 安全说明：密钥以**明文**存在本地 SQLite 里。这对单机 Demo 可以接受，
/// 生产环境应当走密钥管理服务（KMS / Vault）或至少做加密存储。
/// 界面上会如实标注这一点，不假装它是安全的。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 商家：AI 生成内容的「边界」由这里决定
model Merchant {
  id       String  @id @default(cuid())
  name     String
  category String // 品类：火锅 / 咖啡 / 美甲 ...
  city     String
  address  String?
  /// 人均消费（单位：元），本地生活内容的决策关键信息
  avgPrice Int?
  /// JSON string[] 品牌调性关键词，约束 AI 语气
  tones         String @default("[]")
  /// JSON string[] 卖点
  sellingPoints String @default("[]")
  /// JSON string[] 合规禁词（绝对化用语、医疗功效等）
  bannedWords   String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

/// 共创活动：一个活动 = 一批平台框架 + 一张用户任务卡 + 一套奖励阶梯
model Campaign {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  title     String
  /// 到店打卡 / 团购转化 / 口碑沉淀 / 新客拉新
  objective String
  /// JSON Platform[] —— 本次要覆盖的平台
  platforms String @default("[]")
  brief     String @default("")

  /// ↓↓ AI 生成物（商家可改） ↓↓
  /// JSON PlatformFrame[] 各平台内容框架：调性、结构、必含信息、字数码、话题标签
  frames      String @default("[]")
  /// JSON TaskField[] 派给老客的轻量任务卡（只让填空，不让写作文）
  taskCard    String @default("[]")
  /// JSON RewardTier[] 奖励阶梯
  rewardTiers String @default("[]")
  /// llm = 走了真模型；rule = 走了降级规则引擎
  aiMode   String @default("rule")
  aiNote   String @default("")
  /// 同上：只有「本该走模型却失败」才算降级
  degraded Boolean @default(false)

  status String @default("active") // draft | active | closed
  /// 免登录 H5 入口短码，扫码/分享都用它
  publicToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  contents      GeneratedContent[]
  contributions Contribution[]
  rewards       Reward[]
  events        TrackEvent[]

  @@index([merchantId])
}

/// 老客（共创贡献者）：免登录，靠 viewerToken 认人，跨活动累计贡献
model Contributor {
  id          String @id @default(cuid())
  /// H5 首次进入时下发、存在浏览器 localStorage，替代账号体系
  viewerToken String @unique
  nickname    String
  avatarEmoji String @default("🙂")
  phone       String?
  /// qr / link / seed
  sourceChannel String @default("link")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  contributions Contribution[]
  rewards       Reward[]
}

/// 素材提交：老客只做结构化填空 + 一张实拍图
model Submission {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  /// JSON Record<string,string> 按 taskCard 的字段 id 存答案
  answers  String @default("{}")
  imageUrl String?
  /// 图片内容 hash，用于查重反刷
  imageHash String?

  status String @default("processed") // processed | adopted | rejected
  /// JSON RiskFlag[] 风控标记，可解释
  riskFlags String @default("[]")
  /// 本次提交结算到的贡献值
  points Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents      GeneratedContent[]
  contributions Contribution[]
  events        TrackEvent[]

  @@index([campaignId])
  @@index([contributorId])
}

/// AI 产出：同一份老客素材 → 各平台不同调性的内容
model GeneratedContent {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  platform String // xiaohongshu | douyin | dianping
  title    String
  body     String
  /// JSON string[] 话题标签
  tags String @default("[]")
  /// 封面/配图建议
  coverHint String @default("")
  /// 合规自检提示
  complianceNote String @default("")
  /// llm | rule
  aiMode String @default("rule")
  /// 这一行是哪个引擎产出的：llm | rule。
  /// 同一份素材、同一个平台**可以同时存两版**，用于在后台对比两种产出。
  variant String @default("llm")
  /// 是否是「当前采用/展示」的那一版。
  ///
  /// 为什么必须区分：AI 质量面板只能统计 primary，否则给每条内容都存一份对比版，
  /// 比例会变成假的 50/50 —— 那比不统计更误导人。
  /// 对比版不进内容库计数、不进漏斗、不参与质量比例。
  isPrimary Boolean @default(true)
  /// 本次生成的真实降级：**只有「本该走模型却失败了」才为 true**。
  /// 种子数据、未配置 key 走规则引擎都不算降级 —— 不区分这两者，比例数字就会骗人。
  degraded Boolean @default(false)
  /// 生成说明：走了哪条路、为什么、丢弃了什么。用于聚合出降级原因分布。
  aiNote String @default("")

  adopted   Boolean   @default(false)
  adoptedAt DateTime?

  /// 内容短码，用于生成可追踪的分享链接（引流归因）。
  /// 两个版本各自持有独立的 token —— 于是可以把两种产出都分享出去做真实对比。
  shareToken String @unique

  createdAt DateTime @default(now())

  events TrackEvent[]

  @@index([campaignId])
  @@index([submissionId])
  @@index([campaignId, isPrimary])
  /// 同一素材 + 同一平台 + 同一引擎只能有一条
  @@unique([submissionId, platform, variant])
}

/// 贡献记录：分值必须可拆解、可解释，而不是一个黑盒数字
model Contribution {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  submissionId  String?
  submission    Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  /// JSON PointItem[] { label, points, note }
  breakdown String @default("[]")
  points    Int    @default(0)
  reason    String @default("")

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([contributorId])
  /// 同一笔素材 + 同一个理由只能记一次贡献。
  /// 「采用 +30」原本靠应用层 findFirst 检查幂等，并发下两个请求都会查不到而各加一次，
  /// 一条内容就能拿 60 分。改由数据库约束保证。
  @@unique([submissionId, reason])
}

/// 奖励账本：优先发店铺福利（券/赠品），而不是现金
model Reward {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  tierName String
  /// coupon | gift
  type     String @default("coupon")
  title    String
  /// 面额，单位：分
  value    Int    @default(0)
  code     String @unique
  /// issued | redeemed | expired
  status     String    @default("issued")
  issuedAt   DateTime  @default(now())
  redeemedAt DateTime?

  @@index([campaignId])
  @@index([contributorId])
  /// 同一档位只发一次。应用层「先查已发档位、再插入」挡不住并发
  /// （两个请求会同时查到"未发放"），双击提交就能拿到两份券。
  @@unique([campaignId, contributorId, tierName])
}

/// 行为事件：引流归因的钩子。
/// 这张表让「奖励绑定真实引流效果」在 Demo 里就能跑通，而不是一句口号。
model TrackEvent {
  id           String  @id @default(cuid())
  /// view | share | click | redeem
  type         String
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  contentId    String?
  content      GeneratedContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  /// JSON Record<string,string> 渠道、UA 摘要等
  meta String @default("{}")

  /// 访客指纹，用于「同一访客对同一条内容只计一次」。
  /// 不能只靠 cookie 里的 viewer token：不带 cookie 的脚本每次请求都会被发一个新 token，
  /// 等于换个身份就能重复刷分。cookie 缺失时退化用 IP+UA 的哈希。
  viewerKey String?

  createdAt DateTime @default(now())

  @@index([campaignId, type])
  @@index([contentId])
  /// 数据库级去重，挡住并发双击与脚本刷分（应用层先查后插挡不住）
  @@unique([contentId, type, viewerKey])
}
